{
  "name": "portfolio-astro",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint \"src/**/*.{ts,tsx,astro}\" && prettier --check \"**/*.{astro,tsx,ts,md,mdx,json,css,mjs}\"",
    "fix": "eslint \"src/**/*.{ts,tsx,astro}\" --fix && prettier --write \"**/*.{astro,tsx,ts,md,mdx,json,css,mjs}\" && astro check",
    "lighthouse": "npx --yes @unlighthouse/cli@^0.19.1 --site http://localhost:4321",
    "lighthouse:ci": "npx --yes -p @unlighthouse/cli@^0.19.1 unlighthouse-ci --site http://localhost:4321",
    "lighthouse:live": "npx --yes @unlighthouse/cli@^0.19.1 --site https://goldsword.dev",
    "validate": "npm run check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@emailjs/browser": "^4.4.1",
    "astro": "^7.3.6",
    "clsx": "^2.1.1",
    "password-intelligence": "^0.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vercel/analytics": "^1.6.1",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
