---
import { GooglePlayIcon } from "@/components/icons/brands";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { smallImageSrcset } from "@/lib/images";
import type { Metadata } from "@/lib/seo/metadata";

interface Props {
  metadata: Metadata;
  name: string;
  /** Full name for labels and alt text when the heading splits it ("Legends of" + "Aestera") */
  label?: string;
  tagline: string;
  description: string;
  icon: string;
  playUrl: string;
  portfolioSlug: string;
  features: { title: string; description: string }[];
  highlightsTitle: string;
  highlights: string[];
  showcase?: { src: string; alt: string };
  /** Landscape screenshots (games) */
  screens?: string[];
  legal: { privacy: string; terms: string; deleteAccount?: string };
}

const {
  metadata,
  name,
  label = name,
  tagline,
  description,
  icon,
  playUrl,
  portfolioSlug,
  features,
  highlightsTitle,
  highlights,
  showcase,
  screens = [],
  legal,
} = Astro.props;
const showcaseSrcset = showcase ? smallImageSrcset(showcase.src) : undefined;

// Games have no composite, so the first screenshot leads
const [leadScreen, ...moreScreens] = showcase ? [] : screens;

const TONES = ["tile-indigo", "tile-sky", "tile-emerald"];
---

<BaseLayout {...metadata}>
  <section class="relative isolate overflow-hidden pt-28 pb-16 sm:pt-36 md:pb-24">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute -top-48 right-[-12%] h-[32rem] w-[32rem] animate-drift rounded-full bg-primary-500/20 glow"></div>
      <div class="absolute top-48 -left-48 h-[24rem] w-[24rem] animate-drift rounded-full bg-gold-400/15 glow [animation-delay:-11s] dark:bg-gold-400/10"></div>
    </div>

    <div class="section-container section-padding grid items-center gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-16">
      <div>
        <img
          src={icon}
          alt={`${label} simgesi`}
          width="128"
          height="128"
          class="h-20 w-20 animate-fade-up rounded-[1.4rem] object-cover shadow-xl ring-1 ring-black/5 dark:ring-white/10"
        />
        <h1 class="page-title mt-8 animate-rise-in">
          {name}
          <span class="gradient-text block">{tagline}</span>
        </h1>
        <p class="text-body mt-6 max-w-xl animate-fade-up text-lg leading-relaxed [animation-delay:120ms] sm:text-xl sm:leading-relaxed">
          {description}
        </p>
        <div class="mt-9 flex animate-fade-up flex-col gap-3 [animation-delay:200ms] sm:flex-row">
          <a href={playUrl} target="_blank" rel="noopener noreferrer" class="btn-primary btn-lg">
            <span class="flex size-7 items-center justify-center rounded-lg bg-white">
              <GooglePlayIcon size={15} />
            </span>
            Google Play'den indirin
          </a>
          <a href={`/portfolio/${portfolioSlug}`} class="btn-secondary btn-lg">
            Nasıl yaptım? <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {(showcase || leadScreen) && (
        <figure class="relative animate-fade-up [animation-delay:160ms]">
          <div
            aria-hidden="true"
            class="absolute -inset-px rounded-[1.6rem] bg-linear-to-br from-primary-400/60 via-gray-200/40 to-gold-400/60 dark:from-primary-400/40 dark:via-dark-700 dark:to-gold-400/40"
          />
          <div class="relative overflow-hidden rounded-[1.55rem] bg-slate-50 shadow-[0_40px_80px_-40px_rgb(15_17_21/0.45)] dark:bg-dark-800">
            {showcase ? (
              <img
                src={showcase.src}
                srcset={showcaseSrcset}
                sizes={showcaseSrcset ? "(min-width: 1024px) 560px, 100vw" : undefined}
                alt={showcase.alt}
                width="1200"
                height="860"
                class="h-auto w-full"
                fetchpriority="high"
              />
            ) : (
              <img
                src={leadScreen}
                alt={`${label} oyun ekranı 1`}
                width="1200"
                height="668"
                class="aspect-[16/9] h-auto w-full object-cover"
                fetchpriority="high"
              />
            )}
          </div>
        </figure>
      )}
    </div>

    {moreScreens.length > 0 && (
      <div class="section-container section-padding mt-10">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {moreScreens.map((src, index) => (
            <li
              class="overflow-hidden rounded-2xl border border-gray-200 shadow-xs dark:border-dark-700"
              data-reveal
            >
              <img
                src={src}
                alt={`${label} oyun ekranı ${index + 2}`}
                width="1200"
                height="668"
                loading="lazy"
                decoding="async"
                class="aspect-[16/9] h-auto w-full object-cover"
              />
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <section class="section section-tint">
    <div class="section-container section-padding">
      <SectionHeader eyebrow={label} title="Neler var" />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {features.map((feature, index) => (
          <article class="card p-7" data-reveal>
            <span
              class:list={["tile font-mono text-sm font-semibold", TONES[index % TONES.length]]}
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="text-heading mt-6 text-lg font-bold">{feature.title}</h3>
            <p class="text-body mt-2 leading-relaxed">{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-container section-padding">
      <SectionHeader eyebrow="Öne çıkanlar" title={highlightsTitle} />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {highlights.map((item) => (
          <li class="card flex items-start gap-3 p-5" data-reveal>
            <svg
              class="mt-0.5 h-5 w-5 flex-none text-primary-600 dark:text-primary-300"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span class="text-body font-medium">{item}</span>
          </li>
        ))}
      </ul>

      <nav
        aria-label={`${label} yasal bağlantıları`}
        class="mt-16 flex flex-wrap gap-x-6 gap-y-2 border-t border-gray-200/70 pt-8 text-sm dark:border-dark-800"
      >
        <a href={legal.privacy} class="link inline-block py-1.5">
          Gizlilik politikası
        </a>
        <a href={legal.terms} class="link inline-block py-1.5">
          Kullanım koşulları
        </a>
        {legal.deleteAccount && (
          <a href={legal.deleteAccount} class="link inline-block py-1.5">
            Hesap silme
          </a>
        )}
      </nav>
    </div>
  </section>
</BaseLayout>
