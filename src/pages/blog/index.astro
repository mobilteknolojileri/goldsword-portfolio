---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getCollection } from "astro:content";
import { generateMetadata } from "@/lib/seo/metadata";
import { getCategoryBadge, getLocalizedCategory, formatDate } from "@/lib/blog";
import { COPY_TOKENS } from "@/config/seo";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const metadata = generateMetadata({
  title: "Blog: Android, mobil geliştirme ve SEO",
  description:
    "Android sorunları, mobil geliştirme ve teknik SEO üzerine yazdıklarım. Çoğu, gerçek bir sorunu çözerken ortaya çıktı.",
  path: "/blog",
  locale: "tr",
  keywords: ["android destek", "mobil geliştirme", "teknik seo", "astro"],
});
---

<BaseLayout {...metadata}>
  <section class="relative isolate overflow-hidden pt-28 pb-24 sm:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem]">
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute -top-48 right-[-10%] h-[30rem] w-[30rem] rounded-full bg-primary-500/15 glow"></div>
    </div>

    <div class="section-container section-padding">
      <SectionHeader
        as="h1"
        eyebrow="Blog"
        title="Yazdıklarım"
        lead="Android sorunları, mobil geliştirme ve teknik SEO üzerine. Çoğu, gerçek bir sorunu çözerken ortaya çıktı."
      >
        <p class="text-muted mt-4 text-sm" slot="lead">
          {posts.length} yazı ·{" "}
          <a href="/rss.xml" class="link font-medium">
            RSS beslemesi
          </a>
        </p>
      </SectionHeader>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="card-interactive relative flex flex-col p-6 sm:p-7" data-reveal>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class={getCategoryBadge(post.data.category)}>
                {getLocalizedCategory(post.data.category)}
              </span>
              <time datetime={post.data.date.toISOString()} class="text-muted text-xs">
                {formatDate(post.data.date)}
              </time>
            </div>

            <h2 class="text-heading mt-4 text-lg leading-snug font-bold tracking-tight">
              <a
                href={`/blog/${post.id}`}
                class="after:absolute after:inset-0 after:rounded-2xl hover:text-primary-700 dark:hover:text-primary-300"
              >
                {post.data.title}
              </a>
            </h2>

            <p class="text-body mt-3 line-clamp-3 text-[0.9375rem] leading-relaxed">
              {post.data.description}
            </p>

            <p class="mt-auto pt-5 text-sm font-semibold text-primary-700 dark:text-primary-300">
              {COPY_TOKENS.blogListCta} <span aria-hidden="true">→</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
