---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { generateMetadata } from "@/lib/seo/metadata";
import { getBlogFAQSchema, getBlogPostingSchema } from "@/lib/seo/schema";
import {
  getCategoryBadge,
  getLocalizedCategory,
  formatDate,
  calculateReadingTime,
  buildToc,
} from "@/lib/blog";
import { SITE_CONFIG } from "@/config/site";
import { COPY_TOKENS } from "@/config/seo";
import { Image } from "astro:assets";
import { ARTICLE_PROSE } from "@/lib/prose";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => !data.draft);
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const relatedPosts = allPosts
  .filter((post) => post.id !== entry.id)
  .filter((post) => post.data.tags.some((tag) => entry.data.tags.includes(tag)))
  .slice(0, 3);

const readingTime = calculateReadingTime(entry.body ?? "");
const toc = buildToc(headings);
const faq = entry.data.faq ?? [];

// Android posts get their own call to action
const cta =
  entry.data.category === "android"
    ? {
        title: "Sorun devam ediyor mu?",
        body: "Yazı sizin durumunuzu çözmediyse ne olduğunu yazın. Neler denediğinizi de eklerseniz ilk yanıtta daha ileri gideriz.",
        primary: "Sorununuzu anlatın",
      }
    : {
        title: COPY_TOKENS.blogContactCta,
        body: "Ne yapmak istediğinizi kısaca yazın; nereden başlayacağımızı birlikte netleştirelim.",
        primary: "Formu doldurun",
      };

const metadata = generateMetadata({
  title: entry.data.title,
  description: entry.data.description,
  path: `/blog/${entry.id}`,
  locale: "tr",
  type: "article",
  keywords: entry.data.tags,
  image: entry.data.heroImage,
});

const blogSchema = getBlogPostingSchema({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  updated: entry.data.updated,
  url: `${SITE_CONFIG.url}/blog/${entry.id}`,
  image: entry.data.heroImage,
  deviceBrand: entry.data.deviceBrand,
  deviceModel: entry.data.deviceModel,
});

// FAQ schema only for the questions shown on the page
const faqSchema = faq.length ? getBlogFAQSchema(faq) : undefined;
const extraSchemas = faqSchema ? [blogSchema, faqSchema] : [blogSchema];
---

<BaseLayout {...metadata} extraSchemas={extraSchemas}>
  <div
    data-reading-progress
    aria-hidden="true"
    class="pointer-events-none fixed inset-x-0 top-16 z-40 h-[3px] origin-left bg-linear-to-r from-primary-500 via-violet-500 to-gold-400 print:hidden"
    style="transform: scaleX(0)"
  ></div>
  <div class="relative isolate pt-28 pb-20 sm:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[28rem]">
      <div class="bg-grid absolute inset-0"></div>
    </div>
    <article class="section-container section-padding max-w-4xl">
      <header>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
          <span class={getCategoryBadge(entry.data.category)}>
            {getLocalizedCategory(entry.data.category)}
          </span>
          <span class="text-muted">{readingTime} dk. okuma</span>
        </div>

        <h1
          class="text-heading mt-6 text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl"
          style="text-wrap: balance"
        >
          {entry.data.title}
        </h1>

        <p class="text-body mt-6 text-xl leading-relaxed">{entry.data.description}</p>

        <div class="mt-8 flex items-center gap-3 border-y border-gray-100 py-4 dark:border-dark-800">
          <img
            src="/assets/images/profile.webp"
            alt=""
            width="128"
            height="128"
            class="h-10 w-10 rounded-full object-cover"
          />
          <div class="text-sm">
            <p class="text-heading font-semibold">goldsword</p>
            <p class="text-muted">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              {entry.data.updated && (
                <>
                  {" · Güncellendi: "}
                  <time datetime={entry.data.updated.toISOString()}>
                    {formatDate(entry.data.updated)}
                  </time>
                </>
              )}
            </p>
          </div>
        </div>

        {toc.length > 0 && (
          <nav
            aria-labelledby="toc-heading"
            data-toc
            class="mt-10 rounded-2xl border border-gray-200 bg-slate-50 p-6 dark:border-dark-700 dark:bg-dark-800/60"
          >
            <h2 id="toc-heading" class="text-heading text-sm font-semibold">
              İçindekiler
            </h2>
            <ol class="mt-3 space-y-2 text-[0.95rem]">
              {toc.map((item) => (
                <li class:list={[item.depth === 3 && "pl-4"]}>
                  <a
                    href={`#${item.id}`}
                    class="text-body inline-block py-0.5 transition-colors hover:text-primary-700 data-[active=true]:font-semibold data-[active=true]:text-gold-700 dark:hover:text-primary-300 dark:data-[active=true]:text-gold-300"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        {entry.data.heroImage && (
          <div class="mt-10 overflow-hidden rounded-3xl border border-gray-100 shadow-xl dark:border-dark-700">
            <Image
              src={entry.data.heroImage}
              alt={entry.data.title}
              class="h-auto w-full object-cover"
              width={1200}
              height={675}
              loading="eager"
            />
          </div>
        )}
      </header>

      <div class="relative">
        {toc.length > 1 && (
          <div class="absolute inset-y-0 left-full ml-10 hidden w-56 min-[1400px]:block print:hidden">
            <nav data-toc aria-labelledby="toc-side-heading" class="sticky top-28 mt-12">
              <p
                id="toc-side-heading"
                class="text-muted text-xs font-semibold tracking-wider uppercase"
              >
                Bu yazıda
              </p>
              <ol class="mt-3 border-l border-copper-200 dark:border-copper-700/60">
                {toc.map((item) => (
                  <li class:list={[item.depth === 3 && "pl-3"]}>
                    <a href={`#${item.id}`} class="toc-link">
                      {item.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        )}
        <div data-article class:list={["mt-12", ARTICLE_PROSE]}>
          <Content />
        </div>
      </div>

      {faq.length > 0 && (
        <section aria-labelledby="post-faq-heading" class="mt-16">
          <h2
            id="post-faq-heading"
            class="text-heading text-2xl font-extrabold tracking-tight sm:text-3xl"
          >
            Sık sorulan sorular
          </h2>
          <div class="mt-6 divide-y divide-gray-200 border-y border-gray-200 dark:divide-dark-700 dark:border-dark-700">
            {faq.map((item) => (
              <details class="group [&_summary::-webkit-details-marker]:hidden">
                <summary class="text-heading flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-lg font-semibold transition-colors hover:text-primary-700 dark:hover:text-primary-300">
                  {item.question}
                  <span class="mt-0.5 flex h-7 w-7 flex-none items-center justify-center rounded-full bg-primary-50 text-primary-600 ring-1 ring-primary-100 transition-transform duration-300 group-open:rotate-45 dark:bg-primary-400/10 dark:text-primary-300 dark:ring-primary-400/20">
                    <svg
                      class="h-3.5 w-3.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                </summary>
                <p class="text-body -mt-1 pr-12 pb-6 leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <footer class="mt-16 border-t border-gray-100 pt-10 dark:border-dark-800">
        <ul class="flex flex-wrap gap-2" aria-label="Etiketler">
          {entry.data.tags.map((tag) => (
            <li class="badge-neutral">#{tag}</li>
          ))}
        </ul>

        <div class="relative isolate mt-10 overflow-hidden rounded-3xl bg-dark-900 p-8 text-white shadow-[0_40px_80px_-40px_rgb(15_17_21/0.6)] ring-1 ring-white/10 sm:p-10">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
            <div class="absolute -top-24 -left-16 h-64 w-64 rounded-full bg-primary-600/40 glow"></div>
            <div class="absolute -right-10 -bottom-24 h-64 w-64 rounded-full bg-gold-500/20 glow"></div>
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-balance sm:text-3xl">{cta.title}</h2>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-gray-300">{cta.body}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="/#contact"
              class="btn btn-lg bg-white text-gray-900 hover:-translate-y-px hover:bg-gray-100"
            >
              {cta.primary} <span aria-hidden="true">→</span>
            </a>
            <a
              href={`mailto:${SITE_CONFIG.links.email}`}
              class="btn btn-lg text-white ring-1 ring-white/25 hover:bg-white/10"
            >
              {COPY_TOKENS.blogContactSecondaryCta}
            </a>
          </div>
        </div>
      </footer>

      {relatedPosts.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-16">
          <h2 id="related-heading" class="text-heading text-2xl font-extrabold tracking-tight">
            İlgili yazılar
          </h2>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="card-interactive block p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-300">
                  {getLocalizedCategory(post.data.category)}
                </p>
                <h3 class="text-heading mt-2 text-base font-bold leading-snug">
                  {post.data.title}
                </h3>
              </a>
            ))}
          </div>
        </section>
      )}

      <p class="mt-14 text-center">
        <a href="/blog" class="link inline-flex items-center gap-2">
          <span aria-hidden="true">←</span> Bütün yazılar
        </a>
      </p>
    </article>
  </div>
</BaseLayout>
