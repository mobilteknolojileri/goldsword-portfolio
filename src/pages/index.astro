---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/features/hero/Hero.astro";
import TechStrip from "@/features/tech-strip/TechStrip.astro";
import Services from "@/features/services/Services.astro";
import FeaturedWork from "@/features/featured-work/FeaturedWork.astro";
import Testimonials from "@/features/testimonials/Testimonials.astro";
import OpenSource from "@/features/open-source/OpenSource.astro";
import PasswordDemo from "@/features/password-demo";
import Background from "@/features/background/Background.astro";
import Process from "@/features/process/Process.astro";
import Faq from "@/components/ui/Faq.astro";
import Contact from "@/features/contact";
import { FAQ_DATA } from "@/features/faq/data";
import { getLocalBusinessSchema, getFAQSchema } from "@/lib/seo/schema";

const extraSchemas = [getLocalBusinessSchema(), getFAQSchema(FAQ_DATA)];

const emailjsConfig = {
  serviceId: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || "",
  templateId: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || "",
  publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || "",
};
---

<BaseLayout extraSchemas={extraSchemas}>
  <Hero />
  <TechStrip />
  <Services />
  <FeaturedWork />
  <Testimonials />

  <PasswordDemo client:visible>
    <OpenSource />
  </PasswordDemo>
  <Background />
  <Process />
  <Faq items={FAQ_DATA} />
  <Contact client:visible emailjsConfig={emailjsConfig} />
</BaseLayout>
