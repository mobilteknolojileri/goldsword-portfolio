---
import AppPage from "@/layouts/AppPage.astro";
import { PROJECTS } from "@/lib/constants";
import { qusafeMetadata } from "@/lib/seo/metadata";

const project = PROJECTS.find((item) => item.slug === "qusafe-mobile");

const features = [
  {
    title: "Şifre yönetimi",
    description: "Parolalarınızı tek bir şifreli kasada saklarsınız.",
  },
  {
    title: "Şifreli notlar",
    description: "Özel notlarınız da parolalarla aynı kasada, şifreli olarak saklanır.",
  },
  {
    title: "Bulutla eşitleme",
    description: "Kasanız şifreli olarak eşitlenir; sunucu verinizi okuyamaz.",
  },
];

const securityFeatures = [
  "Cihaz üzerinde AES-256-GCM ile şifreleme",
  "Ana paroladan Argon2id ile anahtar türetme",
  "Ana anahtarı saklamayan parmak izi kilidi",
  "Zero-knowledge yaklaşımı: Verinize yalnızca siz erişebilirsiniz",
];
---

<AppPage
  metadata={qusafeMetadata}
  name="QuSafe"
  tagline="Şifreli Kasa"
  description="Parolalarınız ve notlarınız için şifreli bir kasa. Anahtar ana parolanızdan cihazda türetilir; sunucu yalnızca okuyamadığı şifreli veriyi saklar."
  icon="/assets/projects/qusafe-mobile/icon.webp"
  playUrl="https://play.google.com/store/apps/details?id=com.schwerttr.qusafe"
  portfolioSlug="qusafe-mobile"
  features={features}
  highlightsTitle="Güvenlik"
  highlights={securityFeatures}
  showcase={project?.showcase && { src: project.showcase.image, alt: project.showcase.alt }}
  legal={{
    privacy: "/qusafe/privacy-policy",
    terms: "/qusafe/terms-of-service",
    deleteAccount: "/qusafe/delete-account",
  }}
/>
