---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sayfa bulunamadı | goldsword"
  description="Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Ana sayfadan ya da blogdan devam edebilirsiniz."
  robots={{ index: false, follow: true }}
>
  <section class="relative isolate flex min-h-[80vh] items-center overflow-hidden pt-28 pb-20">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute top-1/4 left-1/2 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-primary-500/15 glow"></div>
    </div>

    <div class="section-container section-padding text-center">
      <p
        class="gradient-text text-[7rem] leading-none font-black tracking-tighter sm:text-[10rem]"
        aria-hidden="true"
      >
        404
      </p>
      <h1 class="text-heading mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
        Sayfa bulunamadı
      </h1>
      <p class="text-body mx-auto mt-4 max-w-md text-lg leading-relaxed">
        Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Aşağıdaki bağlantılardan devam
        edebilirsiniz.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary btn-lg">
          Ana sayfaya dönün
        </a>
        <a href="/blog" class="btn-secondary btn-lg">
          Blog yazıları
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
