---
import AppPage from "@/layouts/AppPage.astro";
import { aesteraMetadata } from "@/lib/seo/metadata";

const features = [
  {
    title: "İki karakter",
    description: "Red kılıçla kombo yapar, Robinhood ok atar.",
  },
  {
    title: "20'den fazla bölüm",
    description: "Bölümleri elle tasarladım; tuzaklar, gizli geçitler ve bulmacalar var.",
  },
  {
    title: "Boss savaşları",
    description: "Düşmanların yerini ve boss davranışlarını defalarca elden geçirip dengeledim.",
  },
];

const techHighlights = [
  "Unity 2D ve C#",
  "Çift zıplama, duvarda koşma ve kayma",
  "Orman, mağara ve kale ortamları",
  "Dokunmatik kontrol ve oyun kolu desteği",
  "İlerleme yalnızca cihazda saklanır",
];
---

<AppPage
  metadata={aesteraMetadata}
  name="Legends of"
  label="Legends of Aestera"
  tagline="Aestera"
  description="Unity ile yaptığım 2B platform oyunu. Red ve Robinhood'la tuzaklı bölümleri geçer, boss'larla dövüşürsünüz."
  icon="/assets/projects/legends-of-aestera/hero.webp"
  playUrl="https://play.google.com/store/apps/details?id=com.schwerttr.aestera"
  portfolioSlug="legends-of-aestera"
  features={features}
  highlightsTitle="Oyun hakkında"
  highlights={techHighlights}
  screens={[
    "/assets/projects/legends-of-aestera/screenshot-1.webp",
    "/assets/projects/legends-of-aestera/screenshot-2.webp",
    "/assets/projects/legends-of-aestera/screenshot-3.webp",
  ]}
  legal={{
    privacy: "/legends-of-aestera/privacy-policy",
    terms: "/legends-of-aestera/terms-of-service",
  }}
/>
