---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ui/ProjectCard.astro";
import LinkTile from "@/components/ui/LinkTile.astro";
import Counter from "@/components/ui/Counter.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import SwipeRow from "@/components/ui/SwipeRow.astro";
import PasswordDemo from "@/features/password-demo";
import { PROJECTS } from "@/lib/constants";
import { smallImageSrcset, webpSize } from "@/lib/images";
import { CATEGORY_LABELS, KIND_BADGE, KIND_LABELS, STATUS_LABELS } from "@/config/portfolio";
import { SITE_CONFIG } from "@/config/site";
import { generateMetadata } from "@/lib/seo/metadata";
import { getBreadcrumbSchema } from "@/lib/seo/schema";

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const metadata = generateMetadata({
  title: project.title,
  description: project.description,
  path: `/portfolio/${project.slug}`,
  image: project.showcase?.image ?? project.image ?? "/og.png",
  type: "article",
  keywords: project.technologies,
});

const breadcrumb = getBreadcrumbSchema([
  { name: "Ana sayfa", url: SITE_CONFIG.url },
  { name: "Portfolyo", url: `${SITE_CONFIG.url}/portfolio` },
  { name: project.title, url: `${SITE_CONFIG.url}/portfolio/${project.slug}` },
]);

// Collapse long galleries after six screenshots
const INLINE_SCREENSHOTS = 6;
const screenshots = project.screenshots ?? [];
const inlineShots = screenshots.slice(0, INLINE_SCREENSHOTS);
const moreShots = screenshots.slice(INLINE_SCREENSHOTS);

const sameCategory = PROJECTS.filter(
  (other) => other.slug !== project.slug && other.category === project.category,
);
const related = (
  sameCategory.length > 0
    ? sameCategory
    : PROJECTS.filter((other) => other.slug !== project.slug && other.featured)
).slice(0, 3);
---

<BaseLayout {...metadata} extraSchemas={[breadcrumb]}>
  <article class="relative isolate pt-28 pb-24 sm:pt-36">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] overflow-hidden"
    >
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute -top-48 right-[-10%] h-[30rem] w-[30rem] rounded-full bg-primary-500/15 glow"></div>
    </div>
    <div class="section-container section-padding">
      <nav aria-label="Konum" class="text-sm">
        <a
          href="/portfolio"
          class="text-muted inline-flex items-center gap-1.5 py-1.5 font-medium hover:text-primary-700 dark:hover:text-primary-300"
        >
          <span aria-hidden="true">←</span> Portfolyo
        </a>
      </nav>

      <header class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] lg:items-end">
        <div>
          <div class="flex flex-wrap gap-2">
            {project.kind && (
              <span class={KIND_BADGE[project.kind]}>{KIND_LABELS[project.kind]}</span>
            )}
            {project.kind !== "open-source" && (
              <span class="badge-neutral">{CATEGORY_LABELS[project.category]}</span>
            )}
            {project.status && <span class="badge-neutral">{STATUS_LABELS[project.status]}</span>}
          </div>
          <h1 class="page-title mt-5">{project.title}</h1>
          <p class="text-body mt-5 max-w-2xl text-lg leading-relaxed">{project.description}</p>

          {(project.links.length > 0 || project.caseStudy) && (
            <div class="mt-8 flex flex-wrap items-center gap-3">
              {project.links.map((link) => (
                <LinkTile href={link.url} label={link.label} />
              ))}
              {project.caseStudy && (
                <a href={project.caseStudy} class="btn-primary">
                  Vaka çalışmasını okuyun <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          )}
        </div>

        {project.metrics && project.metrics.length > 0 && (
          <dl class="grid grid-cols-2 gap-3">
            {project.metrics.map((metric) => (
              <div class="card flex flex-col-reverse justify-end p-4">
                <dt class="text-muted mt-1 text-xs leading-snug">{metric.label}</dt>
                <dd class="text-heading text-2xl font-extrabold tabular-nums">
                  <Counter value={metric.value} />
                </dd>
              </div>
            ))}
          </dl>
        )}
      </header>

      {project.showcase ? (
        <figure class="mt-14">
          <div class="relative">
            <div
              aria-hidden="true"
              class="absolute -inset-px rounded-[1.6rem] bg-linear-to-br from-primary-400/60 via-gray-200/40 to-gold-400/60 dark:from-primary-400/40 dark:via-dark-700 dark:to-gold-400/40"
            ></div>
            <div class="relative overflow-hidden rounded-[1.55rem] bg-slate-50 shadow-[0_40px_80px_-40px_rgb(15_17_21/0.45)] dark:bg-dark-800">
              <img
                src={project.showcase.image}
                srcset={smallImageSrcset(project.showcase.image)}
                sizes="(min-width: 1280px) 1200px, 100vw"
                alt={project.showcase.alt}
                width="1200"
                height="840"
                class="h-auto w-full"
                fetchpriority="high"
              />
            </div>
          </div>
          {project.showcase.caption && (
            <figcaption class="text-muted mx-auto mt-4 max-w-3xl text-center text-sm leading-relaxed">
              {project.showcase.caption}
            </figcaption>
          )}
        </figure>
      ) : (
        project.image && (
          <div
            class:list={[
              "relative mt-14 aspect-[16/9] overflow-hidden rounded-3xl border border-gray-200 sm:aspect-[21/9] dark:border-dark-700",
              !project.imageBg && ["bg-linear-to-br", project.color],
            ]}
            style={project.imageBg ? `background: ${project.imageBg}` : undefined}
          >
            {!project.imageBg && (
              <span class="bg-grid absolute inset-0 opacity-40 mix-blend-overlay" />
            )}
            <img
              src={project.image}
              srcset={smallImageSrcset(project.image)}
              sizes="(min-width: 1280px) 1200px, 100vw"
              alt={project.title}
              width="1200"
              height="840"
              class:list={[
                "relative h-full w-full object-contain",
                !project.imageBg && "p-6 drop-shadow-[0_18px_36px_rgb(15_17_21/0.3)] sm:p-8",
              ]}
              fetchpriority="high"
            />
          </div>
        )
      )}

      <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_19rem]">
        <div class="space-y-14">
          <section aria-labelledby="about-heading">
            <h2 id="about-heading" class="text-heading text-2xl font-extrabold tracking-tight">
              Proje hakkında
            </h2>
            <p class="text-body mt-4 text-lg leading-8">{project.detailedDescription}</p>
          </section>

          {project.features.length > 0 && (
            <section aria-labelledby="features-heading">
              <h2 id="features-heading" class="text-heading text-2xl font-extrabold tracking-tight">
                Öne çıkanlar
              </h2>
              <ul class="mt-5 space-y-3">
                {project.features.map((feature) => (
                  <li class="text-body flex gap-3 leading-relaxed">
                    <svg
                      class="mt-1 h-4 w-4 flex-none text-primary-600 dark:text-primary-300"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {project.challenges && (
            <section aria-labelledby="challenges-heading">
              <h2
                id="challenges-heading"
                class="text-heading text-2xl font-extrabold tracking-tight"
              >
                Zorluklar
              </h2>
              <p class="text-body mt-4 text-lg leading-8">{project.challenges}</p>
            </section>
          )}

          {project.gallery?.map((item) => (
            <figure>
              <div class="overflow-hidden rounded-3xl border border-gray-200 bg-gray-50 dark:border-dark-700 dark:bg-dark-800">
                <img
                  src={item.image}
                  srcset={smallImageSrcset(item.image, webpSize(item.image)?.width)}
                  sizes="(min-width: 1024px) 700px, 100vw"
                  alt={item.alt}
                  width={webpSize(item.image)?.width ?? 1200}
                  height={webpSize(item.image)?.height ?? 840}
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full"
                />
              </div>
              {item.caption && (
                <figcaption class="text-muted mt-3 text-center text-sm">{item.caption}</figcaption>
              )}
            </figure>
          ))}

          {screenshots.length > 0 && (
            <section aria-labelledby="screens-heading">
              <h2 id="screens-heading" class="text-heading text-2xl font-extrabold tracking-tight">
                Ekran görüntüleri
              </h2>
              <SwipeRow
                label="Ekran görüntüleri"
                count={inlineShots.length}
                until="sm"
                class="mt-6 items-start sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0 sm:pt-0 sm:pb-0"
              >
                {inlineShots.map((src, index) => (
                  <li class="w-[62%] flex-none snap-start sm:w-auto">
                    <img
                      src={src}
                      alt={`${project.title} ekran görüntüsü ${index + 1}`}
                      width={webpSize(src)?.width}
                      height={webpSize(src)?.height}
                      loading="lazy"
                      decoding="async"
                      class="h-auto w-full rounded-2xl border border-gray-200 dark:border-dark-700"
                    />
                  </li>
                ))}
              </SwipeRow>
              {moreShots.length > 0 && (
                <details class="group mt-2">
                  <summary class="btn-secondary w-fit cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <span class="group-open:hidden">
                      Diğer {moreShots.length} ekran görüntüsünü göster
                    </span>
                    <span class="hidden group-open:inline">Daha az göster</span>
                  </summary>
                  <ul class="mt-6 grid grid-cols-2 items-start gap-4 sm:grid-cols-3">
                    {moreShots.map((src, index) => (
                      <li>
                        <img
                          src={src}
                          alt={`${project.title} ekran görüntüsü ${INLINE_SCREENSHOTS + index + 1}`}
                          width={webpSize(src)?.width}
                          height={webpSize(src)?.height}
                          loading="lazy"
                          decoding="async"
                          class="h-auto w-full rounded-2xl border border-gray-200 dark:border-dark-700"
                        />
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          )}
        </div>

        <aside class="self-start lg:sticky lg:top-24">
          <div class="card p-6">
            <h2 class="text-heading text-sm font-semibold">Teknolojiler</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <li class="badge-neutral">{tech}</li>
              ))}
            </ul>
            <a href="/#contact" class="btn-primary mt-6 w-full">
              Benzer bir iş için yazın
            </a>
            <p class="text-muted mt-3 text-center text-xs">
              İlk yanıtım fiyat teklifi olmaz, birkaç soru olur.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {/* The library's own page runs it live; the home page links here */}
  {project.slug === "react-native-password-intelligence" && <PasswordDemo client:visible />}

  {related.length > 0 && (
    <section class="section section-tint">
      <div class="section-container section-padding">
        <SectionHeader eyebrow="Portfolyo" title="Diğer işler">
          <a href="/portfolio" class="btn-secondary" slot="action">
            Tüm projeler ({PROJECTS.length}) <span aria-hidden="true">→</span>
          </a>
        </SectionHeader>
        <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {related.map((other) => (
            <ProjectCard project={other} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
