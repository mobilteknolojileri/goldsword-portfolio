---
import AppPage from "@/layouts/AppPage.astro";
import { PROJECTS } from "@/lib/constants";
import { kafadarMetadata } from "@/lib/seo/metadata";

const project = PROJECTS.find((item) => item.slug === "kafadar-mobile");

const features = [
  {
    title: "Test hazırlama",
    description: "Soru tipini ve temayı seçerek kendi arkadaşlık testinizi hazırlarsınız.",
  },
  {
    title: "Emoji avatarlar",
    description: "Profilinize kendi seçtiğiniz bir emoji avatar koyarsınız.",
  },
  {
    title: "Puan tablosu",
    description:
      "Testi çözen arkadaşlarınız puanlarına göre sıralanır; sizi en iyi tanıyan en üstte görünür.",
  },
];

const techHighlights = [
  "React Native ve Expo SDK 54",
  "Uygulama kuruluysa testi, değilse web sitesini açan paylaşım bağlantısı (Android App Links)",
  "Veri tabanına bağlanmayan statik bir Astro sitesi ve 4 tablolu Supabase şeması",
  "23 dilde arayüz",
  "Stillerde NativeWind, state yönetiminde Zustand",
];
---

<AppPage
  metadata={kafadarMetadata}
  name="Kafadar"
  tagline="Arkadaşlık Testi"
  description="Kendiniz hakkında bir test yazar, tek bir bağlantıyla arkadaşlarınıza gönderirsiniz. Böylece sizi kimin ne kadar tanıdığını görürsünüz."
  icon="/assets/projects/kafadar-mobile/icon.webp"
  playUrl="https://play.google.com/store/apps/details?id=com.schwerttr.kafadar"
  portfolioSlug="kafadar-mobile"
  features={features}
  highlightsTitle="Teknik özellikler"
  highlights={techHighlights}
  showcase={project?.showcase && { src: project.showcase.image, alt: project.showcase.alt }}
  legal={{
    privacy: "/kafadar/privacy-policy",
    terms: "/kafadar/terms-of-service",
    deleteAccount: "/kafadar/delete-account",
  }}
/>
