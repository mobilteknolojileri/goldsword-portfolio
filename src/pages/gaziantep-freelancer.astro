---
import ServicePage from "@/layouts/ServicePage.astro";
import ProseSection from "@/components/ui/ProseSection.astro";
import type { FaqItem } from "@/features/faq/data";
import { generateMetadata } from "@/lib/seo/metadata";
import { getFAQSchema, getLocalBusinessSchema } from "@/lib/seo/schema";

const metadata = generateMetadata({
  title: "Gaziantep Freelancer Yazılım Geliştirici",
  description:
    "Gaziantep'te freelancer yazılım geliştiriciyim. Web sitesi, mobil uygulama ve teknik SEO işlerini baştan sona tek başıma yürütürüm.",
  path: "/gaziantep-freelancer",
  locale: "tr",
  keywords: [
    "gaziantep freelancer",
    "gaziantep yazılımcı",
    "web tasarım",
    "mobil uygulama geliştirme",
  ],
});

const HIGHLIGHTS = [
  { label: "Konum", value: "Gaziantep" },
  { label: "İşler", value: "Web sitesi, mobil uygulama, backend ve teknik SEO" },
  { label: "Teslim edilen proje", value: "30+" },
  { label: "Müşteri uygulamalarında", value: "23K+ indirme" },
];

const FAQS: FaqItem[] = [
  {
    question: "Gaziantep dışındaki işleri alıyor musunuz?",
    answer:
      "Evet. Gaziantep'teyseniz yüz yüze görüşebiliriz. Şehir dışındaki ve yurt dışındaki projeleri görüntülü görüşmeyle ve ortak bir iş takibiyle yürütürüm. Hatta bugüne kadarki işlerimin çoğu böyle yapıldı.",
  },
  {
    question: "Bir proje ne kadar sürede biter?",
    answer:
      "Kapsama bağlı. Tek sayfalık bir site birkaç gün, çok sayfalı bir kurumsal site bir iki hafta, yayına çıkacak bir mobil uygulama genellikle bir iki ay sürer. İlk görüşmede kapsamı yazıya döker, süreyi söylerim.",
  },
  {
    question: "Teslimden sonra destek veriyor musunuz?",
    answer:
      "Evet. Hata düzeltme, sürüm güncellemesi ve mağaza tarafındaki uyum işleri devam eder. İsterseniz düzenli bir bakım anlaşması yaparız, isterseniz ihtiyaç duyduğunuzda bana yazarsınız.",
  },
];
---

<ServicePage
  metadata={metadata}
  extraSchemas={[getLocalBusinessSchema(), getFAQSchema(FAQS)]}
  eyebrow="Freelancer · Gaziantep"
  title="Gaziantep Freelancer Yazılım Geliştirici ve Web Tasarım"
  lead="Gaziantep'te yaşıyorum. Web sitesi, mobil uygulama ve teknik SEO işleri yapıyorum; projeyi sizinle konuşan da yazan da teslim eden de benim."
  cta={{ label: "Projenizi anlatın", href: "/#contact" }}
  secondaryCta={{ label: "Projelere bakın", href: "/portfolio" }}
  highlights={HIGHLIGHTS}
  projectSlugs={["ingilizceciyiz", "getyo-mobile"]}
  projectsTitle="Hem App Store'da hem Google Play'de yayında iki müşteri uygulaması"
  faqs={FAQS}
>
  <ProseSection title="Ne yapıyorum" tinted>
    <p>
      Web tarafında Astro ve React ile hızlı açılan, arama motorlarının doğru okuduğu siteler
      yaparım. Mobil tarafta React Native ve Flutter ile Google Play ve App Store'a çıkan
      uygulamalar geliştiririm. Bunların arkasındaki backend, veri tabanı ve API işlerini de ben
      üstlenirim.
    </p>
    <p>
      Yayındaki sitelerin teknik SEO'suna da bakarım: taranabilirlik, canonical, şema, sayfa hızı.
      Nitekim <a href="/blog">blogdaki yazıların</a> çoğu bu işler sırasında karşılaştığım gerçek
      hatalardan çıktı.
    </p>
    <p>
      Yayına çıkmış uygulamaları, web projelerini ve SEO çalışmalarını{" "}
      <a href="/portfolio">işler sayfasında</a> bulabilirsiniz. Her birinde ne yaptığımı ve nerede
      zorlandığımı yazdım.
    </p>
  </ProseSection>

  <ProseSection title="Ajans yerine doğrudan geliştirici">
    <p>
      Ajansta araya bir hesap yöneticisi girer ve teknik bir soru zincirin sonuna kadar gidip geri
      döner. Burada öyle bir zincir yok.
    </p>
    <ul>
      <li>Teknik bir sorunuzu doğrudan işi yapan kişiye, yani bana sorarsınız.</li>
      <li>Fiyatı kapsama göre belirler, işe başlamadan yazarım; sonradan kalem eklenmez.</li>
      <li>Revizyonu da kodu yazan kişiyle konuşursunuz.</li>
    </ul>
    <p>
      Öte yandan bunun bir sınırı var: Aynı anda çok sayıda iş yürütmem. Takvimim doluysa bunu en
      başta söylerim.
    </p>
  </ProseSection>
</ServicePage>
