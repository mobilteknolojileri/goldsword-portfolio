---
import ServicePage from "@/layouts/ServicePage.astro";
import ProseSection from "@/components/ui/ProseSection.astro";
import { smallImageSrcset } from "@/lib/images";
import type { FaqItem } from "@/features/faq/data";
import { generateMetadata } from "@/lib/seo/metadata";
import { getFAQSchema, getLocalBusinessSchema } from "@/lib/seo/schema";

const metadata = generateMetadata({
  title: "Gaziantep Web Site Yapımı ve Web Tasarım Hizmeti",
  description:
    "Gaziantep'te web sitesi yapımı: işletmeler için hızlı açılan, arama motorlarının doğru okuduğu kurumsal siteler ve tanıtım sayfaları, teknik SEO kurulumuyla.",
  path: "/web-site-yapimi-gaziantep",
  locale: "tr",
  keywords: ["web site yapımı", "web tasarım gaziantep", "kurumsal web sitesi", "teknik seo"],
});

const HIGHLIGHTS = [
  { label: "Altyapı", value: "Astro: Tarayıcıya neredeyse hiç JavaScript gitmez" },
  { label: "Hız", value: "Son teslim ettiğim sitelerde mobil PageSpeed performans puanı 100" },
  { label: "Teknik SEO", value: "Ayrı bir kalem değil, kurulumun parçası" },
  { label: "Teslim", value: "Alan adınıza kurulum; kaynak kod sizin" },
];

const FAQS: FaqItem[] = [
  {
    question: "Site Google'da çıkacak mı?",
    answer:
      "Teknik tarafı garanti ederim: Site taranabilir olur, canonical ve şema işaretlemesi doğru kurulur, sayfalar hızlı açılır. Öte yandan sıralama bunun üstüne rekabete ve içeriğe bağlıdır; bu yüzden kimse sıra garantisi veremez. Veren olursa dinlemeyin.",
  },
  {
    question: "Sitemi kendim güncelleyebilecek miyim?",
    answer:
      "İhtiyaca göre. Fiyat ve çalışma saati gibi sık değişen alanlar için panel kurarım. Yılda bir iki kez değişen kurumsal bir metin için panel gereksiz bir masraf; o durumda değişikliği ben yaparım.",
  },
  {
    question: "Hazır tema ile yapmıyor musunuz?",
    answer:
      "Hayır. Hazır tema ilk gün ucuz görünür ama kullanılmayan onlarca eklentiyi de beraberinde getirir; site yavaşlar, üstelik her güncelleme bir risk olur. Ben sayfaları sıfırdan yazarım, siteye yalnızca gereken kod gider.",
  },
];
---

<ServicePage
  metadata={metadata}
  extraSchemas={[getLocalBusinessSchema(), getFAQSchema(FAQS)]}
  eyebrow="Web sitesi · Gaziantep"
  title="Gaziantep Web Site Yapımı ve Web Tasarım Hizmeti"
  lead="Bir web sitesinin güzel görünmesi yetmez. Sizi arayan kişi siteyi bulmalı, sayfa açılırken beklememeli ve ne iş yaptığınızı hemen anlamalı. Siteleri buna göre kurarım."
  cta={{ label: "Projenizi anlatın", href: "/#contact" }}
  secondaryCta={{ label: "Projelere bakın", href: "/portfolio" }}
  highlights={HIGHLIGHTS}
  projectSlugs={["gmb-optimizasyonu", "getyo-admin"]}
  faqs={FAQS}
>
  <ProseSection title="Nasıl kuruluyor" tinted>
    <p>
      Siteyi Astro ile hazırlarım; ziyaretçinin tarayıcısına neredeyse hiç JavaScript gitmez.
      Dolayısıyla sayfalar eski bir telefonda bile hızlı açılır ve arama motoru onları ilk denemede
      eksiksiz okur.
    </p>
    <p>Kurulum sırasında teknik SEO'yu da yaparım:</p>
    <ul>
      <li>Her sayfanın canonical adresi, başlığı ve açıklaması</li>
      <li>Sitemap, robots ve şema işaretlemesi</li>
      <li>Görsellerin derleme sırasında küçültülmesi ve ölçülerinin verilmesi</li>
      <li>Adres sonundaki slash, yönlendirmeler ve 404 davranışının her yerde aynı olması</li>
    </ul>
    <p>
      Bunların neden önemli olduğunu <a href="/blog">blogda</a> tek tek yazdım; oradaki yazıların
      çoğu bu sitelerde karşılaştığım hatalardan çıktı.
    </p>
  </ProseSection>

  <ProseSection title="Yerel işletme için">
    <p>
      Gaziantep'te arama yapan biri genellikle telefondan ve acele arar. Bu yüzden ilk ekrana ne
      yaptığınızı, nerede olduğunuzu ve size nasıl ulaşılacağını koyarım; gerisi aşağıda gelir.
    </p>
    <p>
      Google İşletme Profili de aslında sitenin bir parçası gibi çalışır. Profilini düzelttiğim bir
      işletmenin öncesini ve sonrasını <a href="/portfolio/gmb-optimizasyonu">işler sayfasında</a>{" "}
      görebilirsiniz.
    </p>
    <figure>
      <img
        src="/assets/projects/frozen-yogurt-website/site.webp"
        srcset={smallImageSrcset("/assets/projects/frozen-yogurt-website/site.webp")}
        sizes="(min-width: 768px) 720px, 100vw"
        alt="Frozen Yogurt Cafe sitesinin ilk ekranı"
        width="1200"
        height="816"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        Yaptığım bir dükkân sitesinin ilk ekranı: sadakat programına davet ve günün çalışma
        saatleri. Saatleri personel panelden günceller, tatil günü için yeni sürüm gerekmez.
      </figcaption>
    </figure>
    <p>
      Bu siteyi nasıl kurduğumu <a href="/portfolio/frozen-yogurt-website">proje sayfasında</a>{" "}
      anlattım.
    </p>
  </ProseSection>

  <ProseSection title="Teslim" tinted>
    <p>
      Siteyi alan adınıza kurarım. Panel gerekiyorsa onu da kurar, nasıl kullanılacağını gösteririm.
      Kaynak kod sizindir; başka biriyle devam etmek isterseniz elinizde eksik bir şey kalmaz.
    </p>
  </ProseSection>
</ServicePage>
