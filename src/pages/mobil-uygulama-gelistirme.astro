---
import ServicePage from "@/layouts/ServicePage.astro";
import ProseSection from "@/components/ui/ProseSection.astro";
import Steps from "@/components/ui/Steps.astro";
import type { FaqItem } from "@/features/faq/data";
import { generateMetadata } from "@/lib/seo/metadata";
import { getFAQSchema, getLocalBusinessSchema } from "@/lib/seo/schema";

const metadata = generateMetadata({
  title: "Mobil Uygulama Geliştirme: React Native ve Flutter",
  description:
    "iOS ve Android için tek kod tabanıyla mobil uygulama geliştirme. Fikirden mağazaya kadar tasarımı, geliştirmeyi ve yayını ben yürütürüm.",
  path: "/mobil-uygulama-gelistirme",
  locale: "tr",
  keywords: ["mobil uygulama geliştirme", "flutter", "react native", "ios", "android"],
});

const HIGHLIGHTS = [
  {
    label: "Platform",
    value: "iOS ve Android, tek kod tabanıyla: React Native ve Expo ya da Flutter",
  },
  {
    label: "Dâhil",
    value: "Mağaza hesabı, sürüm imzası, mağaza metinleri, veri güvenliği formu ve yasal sayfalar",
  },
  { label: "Müşteri uygulamalarında", value: "23K+ indirme" },
  { label: "Google Play'de", value: "Kafadar, QuSafe, Legends of Aestera" },
];

const STEPS = [
  {
    title: "Kapsam",
    body: "Ekran listesini, kullanıcı akışını ve ilk sürüme nelerin girmeyeceğini birlikte yazıya dökeriz. Bu adım atlanırsa proje yolda büyür.",
  },
  {
    title: "Tasarım",
    body: "Ekranları ve geçişleri çizerim. Kod yazmaya başlamadan önce onayınızı alırım.",
  },
  {
    title: "Geliştirme",
    body: "İş ilerledikçe çalışan sürümleri parça parça teslim ederim. Diğer bir deyişle, uygulamayı ilk kez en sonda görmezsiniz.",
  },
  {
    title: "Yayın ve sonrası",
    body: "Mağaza hesabını, sürüm imzasını, metinleri, veri güvenliği formunu ve yasal sayfaları hazırlarım. Yayından sonra çökmeleri takip eder, güncellemeleri çıkarırım.",
  },
];

const FAQS: FaqItem[] = [
  {
    question: "React Native mi, Flutter mı?",
    answer:
      "İşe göre değişir. Ürünü sonradan bir ekip sürdürecekse ve web tarafıyla kod paylaşılacaksa React Native, arayüz ve animasyon ağırlıklı bir işse Flutter seçerim. Kararı ilk görüşmede birlikte veririz.",
  },
  {
    question: "Uygulamayı mağazaya siz mi yüklüyorsunuz?",
    answer:
      "Evet, yükleme işin içinde: Google Play ve App Store hesabının açılması, sürüm imzası, mağaza metinleri, ekran görüntüleri ve veri güvenliği formu. Gizlilik politikası ve hesap silme sayfası da gerekir; ikisini de ben kurarım.",
  },
  {
    question: "Uygulama reddedilirse ne olur?",
    answer:
      "Ret gerekçesini okur, düzeltir ve yeniden gönderirim; bu iş kapsamın içindedir. Retlerin çoğu izin açıklaması, veri formu ya da eksik yasal sayfa yüzünden olur. Baştan doğru hazırlanınca bu tür retler genellikle yaşanmaz.",
  },
];
---

<ServicePage
  metadata={metadata}
  extraSchemas={[getLocalBusinessSchema(), getFAQSchema(FAQS)]}
  eyebrow="Mobil uygulama · iOS ve Android"
  title="Mobil Uygulama Geliştirme: React Native ve Flutter"
  lead="Uygulama fikriyle mağazadaki uygulama arasında tasarım, geliştirme, test ve yayın adımları var. Dördünü de ben yürütürüm."
  cta={{ label: "Projenizi anlatın", href: "/#contact" }}
  secondaryCta={{ label: "Projelere bakın", href: "/portfolio" }}
  highlights={HIGHLIGHTS}
  projectSlugs={["ingilizceciyiz", "getyo-mobile"]}
  projectsTitle="Hem App Store'da hem Google Play'de yayında iki müşteri uygulaması"
  faqs={FAQS}
>
  <ProseSection title="Tek kod tabanı" tinted>
    <p>
      iOS ve Android'i ayrı ayrı yazmak bakımı ikiye katlar. React Native ve Flutter'da iki platform
      da aynı koddan çıkar; platforma özel bir davranış gerektiğinde yalnızca o kısım ayrı yazılır.
      Aşağıdaki iki uygulama da böyle yapıldı: İki mağazada aynı kod çalışıyor.
    </p>
    <p>
      Kullandığım araçlar: React Native ve Expo, Flutter, Supabase, Firebase ve gerektiğinde kendi
      yazdığım API. Bunlarla yayına çıkmış uygulamaları <a href="/portfolio">işler sayfasında</a>
      görebilirsiniz.
    </p>
  </ProseSection>

  <Steps title="Uygulama geliştirme süreci" steps={STEPS} />

  <ProseSection title="Mağaza tarafı" tinted>
    <p>
      Google Play her uygulamadan çalışan bir gizlilik politikası adresi ister; hesap açılabilen
      uygulamalarda bir hesap silme adresi de şarttır. Dolayısıyla bu sayfalar eksikse uygulama
      yayına alınmaz, alınmışsa listeden kaldırılabilir. Kendi uygulamalarımda bunları nasıl
      kurduğumu aşağıdaki sayfalarda görebilirsiniz:
    </p>
    <ul>
      <li>
        <a href="/kafadar">Kafadar</a>: <a href="/kafadar/privacy-policy">Gizlilik Politikası</a>,
        <a href="/kafadar/delete-account">Hesap Silme</a>
      </li>
      <li>
        <a href="/qusafe">QuSafe</a>: <a href="/qusafe/privacy-policy">Gizlilik Politikası</a>,
        <a href="/qusafe/delete-account">Hesap Silme</a>
      </li>
      <li>
        <a href="/legends-of-aestera">Legends of Aestera</a>:
        <a href="/legends-of-aestera/privacy-policy">Gizlilik Politikası</a>
      </li>
    </ul>
  </ProseSection>
</ServicePage>
