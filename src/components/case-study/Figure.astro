---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
}

const { src, alt, width, height } = Astro.props;
---

<figure class="not-prose my-10">
  <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-[0_24px_60px_-34px_rgb(15_17_21/0.45)] dark:border-dark-700 dark:bg-dark-800">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="h-auto w-full"
    />
  </div>
  {Astro.slots.has("default") && (
    <figcaption class="text-muted mt-3 text-sm leading-relaxed [&_a]:link [&_p]:m-0">
      <slot />
    </figcaption>
  )}
</figure>
