---
import type { FaqItem } from "@/features/faq/data";

interface Props {
  items: FaqItem[];
  title?: string;
  eyebrow?: string;
  lead?: string;
  id?: string;
}

const {
  items,
  title = "Sıkça sorulan sorular",
  eyebrow = "SSS",
  lead = "Aradığınız cevap burada yoksa doğrudan sorun; formdan ya da e-postayla yazabilirsiniz.",
  id = "faq",
} = Astro.props;
---

<section id={id} class="section border-t border-gray-200/70 dark:border-dark-800">
  <div class="section-container section-padding grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <p class="eyebrow mb-4">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      <p class="section-lead">{lead}</p>
      <a href="/#contact" class="btn-secondary mt-8">
        Soru sorun <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="divide-y divide-gray-200 border-y border-gray-200 dark:divide-dark-700 dark:border-dark-700">
      {items.map((item) => (
        <details class="group [&_summary::-webkit-details-marker]:hidden" data-reveal>
          <summary class="text-heading flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left text-lg font-semibold transition-colors hover:text-primary-700 dark:hover:text-primary-300">
            {item.question}
            <span class="mt-0.5 flex h-7 w-7 flex-none items-center justify-center rounded-full bg-primary-50 text-primary-600 ring-1 ring-primary-100 transition-transform duration-300 group-open:rotate-45 dark:bg-primary-400/10 dark:text-primary-300 dark:ring-primary-400/20">
              <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </summary>
          <p class="text-body -mt-1 pr-12 pb-6 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
