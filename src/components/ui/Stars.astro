---
interface Props {
  count?: number;
  /** Read out instead of the stars. Without it they're hidden from screen readers. */
  label?: string;
  class?: string;
}

const { count = 5, label, class: className } = Astro.props;
---

<span
  class:list={["stars", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {Array.from({ length: count }, () => (
    <span class="star" />
  ))}
</span>
