---
// A row of cards that scrolls sideways on phones and turns into the grid given in `class` from
// the `until` breakpoint up. motion.ts moves the thumb, updates the counter and nudges the row
// once so it reads as swipeable.
interface Props {
  label: string;
  count: number;
  until: "sm" | "md";
  class?: string;
}

const { label, count, until, class: className } = Astro.props;
const barHidden = { sm: "sm:hidden", md: "md:hidden" }[until];
---

<div data-carousel>
  <ul
    data-carousel-track
    aria-label={label}
    class:list={[
      "no-scrollbar relative -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 pt-1 pb-6",
      className,
    ]}
  >
    <slot />
  </ul>
  <div aria-hidden="true" class:list={["flex items-center gap-4", barHidden]}>
    <span class="relative h-1 flex-1 overflow-hidden rounded-full bg-gray-200/80 dark:bg-dark-700">
      <span
        data-carousel-thumb
        class="absolute inset-y-0 left-0 w-1/3 rounded-full bg-linear-to-r from-gold-300 to-gold-500 shadow-[0_0_8px_rgb(246_205_102/0.7)]"
      ></span>
    </span>
    <span data-carousel-count class="text-muted font-mono text-xs tabular-nums">
      1 / {count}
    </span>
  </div>
</div>
