---
import type { Project } from "@/lib/constants";
import { smallImageSrcset } from "@/lib/images";
import { CATEGORY_LABELS, KIND_BADGE, KIND_LABELS } from "@/config/portfolio";
import Counter from "@/components/ui/Counter.astro";

interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
  /** First card on screen: its image loads at once and is the page's largest paint */
  priority?: boolean;
  /** Off for cards that are already on screen when the page opens */
  reveal?: boolean;
  /** Width of the image slot in the grid the card sits in */
  sizes?: string;
}

const {
  project,
  headingLevel = "h3",
  priority = false,
  reveal = true,
  sizes = "(min-width: 1024px) 384px, (min-width: 768px) 45vw, 100vw",
} = Astro.props;
const Heading = headingLevel;
const href = `/portfolio/${project.slug}`;
const imageSrc = project.showcase?.image ?? project.image;

const srcset = smallImageSrcset(imageSrc);
const imageAttrs = {
  src: imageSrc,
  srcset,
  sizes: srcset ? sizes : undefined,
  alt: "",
  width: 1200,
  height: 840,
  loading: priority ? "eager" : "lazy",
  fetchpriority: priority ? "high" : undefined,
  decoding: "async",
} as const;

// flex-col-reverse + justify-end keeps the metric values top-aligned
const metrics = project.metrics?.slice(0, 3) ?? [];
---

<article
  class="card-interactive group flex h-full w-full flex-col overflow-hidden"
  data-reveal={reveal ? "" : undefined}
>
  {!imageSrc && (
    <a
      href={href}
      class:list={[
        "relative flex aspect-[10/7] flex-col justify-end overflow-hidden bg-linear-to-br p-6 text-white",
        project.color,
      ]}
      tabindex="-1"
      aria-hidden="true"
    >
      <span class="bg-grid absolute inset-0 opacity-40 mix-blend-overlay" />
      <span class="relative font-mono text-xs tracking-[0.16em] uppercase opacity-80">
        {project.technologies[0]}
      </span>
      <span class="relative mt-2 text-2xl leading-tight font-extrabold">{project.title}</span>
    </a>
  )}
  {imageSrc && (
    <a
      href={href}
      class:list={[
        "relative block aspect-[10/7] overflow-hidden border-b border-gray-100 dark:border-dark-700",
        project.showcase
          ? "bg-slate-100 dark:bg-dark-900"
          : !project.imageBg && ["bg-linear-to-br", project.color],
      ]}
      style={!project.showcase && project.imageBg ? `background: ${project.imageBg}` : undefined}
      tabindex="-1"
      aria-hidden="true"
    >
      {project.showcase ? (
        <img
          {...imageAttrs}
          class="h-full w-full object-cover object-top transition duration-700 ease-out group-hover:scale-[1.03]"
        />
      ) : project.imageBg ? (
        <img
          {...imageAttrs}
          class="h-full w-full object-contain transition duration-700 ease-out group-hover:scale-[1.04]"
        />
      ) : (
        <>
          <span class="bg-grid absolute inset-0 opacity-40 mix-blend-overlay" />
          <img
            {...imageAttrs}
            class="relative h-full w-full object-contain p-6 drop-shadow-[0_14px_28px_rgb(15_17_21/0.3)] transition duration-700 ease-out group-hover:scale-[1.04]"
          />
        </>
      )}
    </a>
  )}
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="flex flex-wrap gap-2">
      {project.kind && <span class={KIND_BADGE[project.kind]}>{KIND_LABELS[project.kind]}</span>}
      {project.kind !== "open-source" && (
        <span class="badge-neutral">{CATEGORY_LABELS[project.category]}</span>
      )}
    </div>
    <Heading class="text-heading mt-4 text-xl font-bold tracking-tight">
      <a href={href} class="hover:text-primary-700 dark:hover:text-primary-300">
        {project.title}
      </a>
    </Heading>
    <p class="text-body mt-2 text-[0.9375rem] leading-relaxed">{project.description}</p>

    {metrics.length > 0 && (
      <dl class="mt-6 grid grid-cols-3 gap-3">
        {metrics.map((metric) => (
          <div class="flex flex-col-reverse justify-end rounded-xl bg-slate-50 p-3 ring-1 ring-gray-100 dark:bg-dark-900/60 dark:ring-dark-700">
            <dt class="text-muted mt-1 text-xs leading-snug">{metric.label}</dt>
            <dd class="text-heading text-base leading-tight font-bold whitespace-nowrap tabular-nums sm:text-lg">
              <Counter value={metric.value} />
            </dd>
          </div>
        ))}
      </dl>
    )}

    <p class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6 text-sm">
      <a href={href} class="link">
        Projeyi inceleyin<span class="sr-only">: {project.title}</span>
        <span aria-hidden="true">→</span>
      </a>
      {project.caseStudy && (
        <a href={project.caseStudy} class="link">
          Vaka çalışması<span class="sr-only">: {project.title}</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </p>
  </div>
</article>
