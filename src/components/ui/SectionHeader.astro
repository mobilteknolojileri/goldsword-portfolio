---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  as?: "h1" | "h2";
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, as: Heading = "h2", id, class: className } = Astro.props;
const hasAction = Astro.slots.has("action");
// A page title is on screen from the start, so it rises in with CSS instead of the scroll reveal
const isPageTitle = Heading === "h1";
---

<div
  class:list={[
    "flex flex-col gap-6",
    hasAction && "md:flex-row md:items-end md:justify-between md:gap-10",
    className,
  ]}
>
  <div
    class:list={["max-w-2xl", isPageTitle && "animate-rise-in"]}
    data-reveal={isPageTitle ? undefined : ""}
  >
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <Heading id={id} class={isPageTitle ? "page-title" : "section-title"}>
      {title}
    </Heading>
    {lead && <p class="section-lead">{lead}</p>}
    <slot name="lead" />
  </div>
  {hasAction && (
    <div class="flex-none" data-reveal>
      <slot name="action" />
    </div>
  )}
</div>
