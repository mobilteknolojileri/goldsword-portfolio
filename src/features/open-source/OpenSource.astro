---
import { OPEN_SOURCE } from "@/lib/open-source";
import LinkTile from "@/components/ui/LinkTile.astro";

// A band that is dark in both themes. The `dark` class on the inner wrapper gives the link tiles
// their dark look in the light theme too.
---

<section
  id="open-source"
  aria-labelledby="open-source-heading"
  class="relative isolate overflow-hidden bg-dark-900 py-20 text-white sm:py-24 lg:py-28 dark:border-y dark:border-dark-800 dark:bg-dark-950"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="glow absolute -top-40 left-[8%] h-[28rem] w-[28rem] rounded-full bg-primary-600/30"></div>
    <div class="glow absolute right-[-6%] -bottom-48 h-[26rem] w-[26rem] rounded-full bg-gold-500/15"></div>
  </div>

  <div class="dark section-container section-padding">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-4 text-primary-200">Açık kaynak</p>
      <h2
        id="open-source-heading"
        class="text-3xl leading-[1.12] font-bold tracking-tight text-balance text-white sm:text-4xl lg:text-[2.6rem]"
      >
        Kütüphane ve kabul edilen katkılar
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-pretty text-gray-300">
        Kütüphanenin kodu açık. Türkçe desteği için iki projeye daha katkı gönderdim; ikisini de
        projelerin bakımcıları inceleyip birleştirdi.
      </p>
      <a
        href="/portfolio/react-native-password-intelligence#password-demo"
        class="mt-6 inline-flex items-center gap-2 py-1.5 font-semibold text-primary-300 underline-offset-4 hover:text-primary-200 hover:underline"
      >
        Parola ölçeri tarayıcıda deneyin <span aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="mt-10 grid gap-4 lg:grid-cols-3">
      {OPEN_SOURCE.map((item) => (
        <li class="flex flex-col rounded-2xl bg-white/[0.04] p-6 ring-1 ring-white/10" data-reveal>
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">{item.kind}</span>
            {item.meta && <span class="font-mono text-xs text-gray-400">{item.meta}</span>}
          </div>
          <h3 class="mt-4 text-lg font-bold tracking-tight text-white">{item.title}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-gray-300">{item.body}</p>
          <div class="mt-auto flex flex-wrap gap-2 pt-6">
            {item.links.map((link) => (
              <LinkTile href={link.href} label={link.label} size="sm" />
            ))}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
