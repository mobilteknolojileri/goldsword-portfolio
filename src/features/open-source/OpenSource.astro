---
import { OPEN_SOURCE } from "@/lib/open-source";
import LinkTile from "@/components/ui/LinkTile.astro";

// Rendered inside the password demo band, which is dark in both themes. The `dark` class on
// the wrapper gives the link tiles their dark look there too.
---

<div class="dark mt-16 border-t border-white/10 pt-12 sm:mt-20">
  <div class="max-w-2xl">
    <p class="eyebrow mb-4 text-primary-200">Açık kaynak</p>
    <h3 class="text-2xl font-bold tracking-tight text-balance text-white sm:text-3xl">
      Kütüphane ve kabul edilen katkılar
    </h3>
    <p class="mt-3 leading-relaxed text-pretty text-gray-300">
      Kütüphanenin kodu açık. Türkçe desteği için iki projeye daha katkı gönderdim; ikisini de
      projelerin bakımcıları inceleyip birleştirdi.
    </p>
  </div>

  <ul class="mt-8 grid gap-4 lg:grid-cols-3">
    {OPEN_SOURCE.map((item) => (
      <li class="flex flex-col rounded-2xl bg-white/[0.04] p-6 ring-1 ring-white/10">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge">{item.kind}</span>
          {item.meta && <span class="font-mono text-xs text-gray-400">{item.meta}</span>}
        </div>
        <h4 class="mt-4 text-lg font-bold tracking-tight text-white">{item.title}</h4>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-gray-300">{item.body}</p>
        <div class="mt-auto flex flex-wrap gap-2 pt-6">
          {item.links.map((link) => (
            <LinkTile href={link.href} label={link.label} size="sm" />
          ))}
        </div>
      </li>
    ))}
  </ul>
</div>
