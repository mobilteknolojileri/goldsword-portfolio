---
import {
  HOME_TESTIMONIALS,
  TESTIMONIALS,
  TESTIMONIAL_COUNT,
  TESTIMONIAL_PEOPLE,
  TESTIMONIAL_REPEAT_PEOPLE,
} from "@/lib/testimonials";
import { SITE_CONFIG } from "@/config/site";
import Counter from "@/components/ui/Counter.astro";
import LinkTile from "@/components/ui/LinkTile.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Stars from "@/components/ui/Stars.astro";
import SwipeRow from "@/components/ui/SwipeRow.astro";

const averageRating = (
  TESTIMONIALS.reduce((sum, item) => sum + item.rating, 0) / TESTIMONIAL_COUNT
).toLocaleString("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// Reviews from repeat customers
const reviewsPerUser = TESTIMONIALS.reduce<Record<string, number>>((counts, item) => {
  counts[item.user] = (counts[item.user] ?? 0) + 1;
  return counts;
}, {});
const repeatReviews = TESTIMONIALS.filter((item) => (reviewsPerUser[item.user] ?? 0) > 1).length;

const others = TESTIMONIALS.filter((item) => !item.home);

const STATS = [
  { value: String(TESTIMONIAL_COUNT), label: "Yorum" },
  { value: String(TESTIMONIAL_PEOPLE), label: "Kişi" },
  { value: averageRating, label: "Ortalama puan" },
];
---

<section id="testimonials" class="section section-tint">
  <div class="section-container section-padding">
    <SectionHeader
      eyebrow="Yorumlar"
      title="Müşteri yorumları"
      lead="Yorumların hepsi Bionluk'tan. Olduğu gibi aldım, yazım hatalarına da dokunmadım; kullanıcı adına tıklarsanız yorumun yazıldığı profil açılır."
    >
      <dl class="grid grid-cols-3 gap-3 text-center" slot="action">
        {STATS.map((stat) => (
          <div class="card flex min-w-24 flex-col-reverse justify-end px-4 py-4">
            <dt class="text-muted mt-1 text-xs">{stat.label}</dt>
            <dd class="text-heading text-3xl font-extrabold tabular-nums">
              <Counter value={stat.value} />
            </dd>
          </div>
        ))}
      </dl>
    </SectionHeader>

    <p class="text-body mt-6 text-sm" data-reveal>
      {TESTIMONIAL_COUNT} yorumun {repeatReviews} tanesi, bana birden fazla kez iş veren{" "}
      {TESTIMONIAL_REPEAT_PEOPLE} kişiden.
    </p>

    <SwipeRow
      label="Seçili yorumlar"
      count={HOME_TESTIMONIALS.length}
      until="md"
      class="mt-8 md:mx-0 md:mt-10 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 md:pt-0 md:pb-0 lg:grid-cols-3"
    >
      {HOME_TESTIMONIALS.map((item) => (
        <li
          class="card relative flex w-[86%] flex-none snap-start flex-col p-6 sm:p-7 md:w-auto"
          data-reveal
        >
          <svg
            class="absolute top-6 right-6 h-8 w-8 text-primary-100 dark:text-dark-700"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M9.6 6C6.5 7.4 4.5 10 4.5 13.3c0 2.6 1.6 4.5 3.8 4.5 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.7 1.9-3.3 3.8-4.2L9.6 6Zm8.9 0c-3.1 1.4-5.1 4-5.1 7.3 0 2.6 1.6 4.5 3.8 4.5 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.7 1.9-3.3 3.8-4.2L18.5 6Z" />
          </svg>
          <Stars count={item.rating} label={`5 üzerinden ${item.rating} yıldız`} />
          <blockquote class="text-body mt-4 flex-1 leading-relaxed">{item.text}</blockquote>
          <a
            href={item.profile}
            target="_blank"
            rel="noopener noreferrer"
            class="link mt-6 font-mono text-sm font-medium"
          >
            @{item.user}
          </a>
        </li>
      ))}
    </SwipeRow>

    <details class="group mt-8">
      <summary class="btn-secondary flex w-fit cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Diğer {others.length} yorumu göster</span>
        <span class="hidden group-open:inline">Diğer yorumları gizle</span>
      </summary>
      <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {others.map((item) => (
          <li class="card flex flex-col p-6 sm:p-7">
            <Stars count={item.rating} label={`5 üzerinden ${item.rating} yıldız`} />
            <blockquote class="text-body mt-4 flex-1 leading-relaxed">{item.text}</blockquote>
            <a
              href={item.profile}
              target="_blank"
              rel="noopener noreferrer"
              class="link mt-6 font-mono text-sm font-medium"
            >
              @{item.user}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <div class="mt-8">
      <LinkTile
        href={SITE_CONFIG.links.bionluk}
        label="Tümünü Bionluk profilimde görün"
        detail="bionluk.com/goldsword"
      />
    </div>
  </div>
</section>
