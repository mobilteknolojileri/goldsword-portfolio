---
import {
  SiAstro,
  SiDocker,
  SiExpo,
  SiFastapi,
  SiFirebase,
  SiFlutter,
  SiNextdotjs,
  SiNodedotjs,
  SiPostgresql,
  SiPython,
  SiReact,
  SiSupabase,
  SiTailwindcss,
  SiTensorflow,
  SiTypescript,
  SiUnity,
} from "react-icons/si";

// Only tech used in the portfolio projects, in brand colours (lighter in dark mode). Colours follow
// Simple Icons' current list: Firebase turned red and Node.js changed its green in 2024.
const TECH = [
  { name: "React Native", Icon: SiReact, light: "#087ea4", dark: "#61dafb" },
  { name: "Expo", Icon: SiExpo, light: "#1c2024", dark: "#ffffff" },
  { name: "Flutter", Icon: SiFlutter, light: "#02569b", dark: "#54c5f8" },
  { name: "TypeScript", Icon: SiTypescript, light: "#3178c6", dark: "#5da3e8" },
  { name: "Supabase", Icon: SiSupabase, light: "#24b47e", dark: "#3ecf8e" },
  { name: "PostgreSQL", Icon: SiPostgresql, light: "#336791", dark: "#8fb8ea" },
  { name: "Firebase", Icon: SiFirebase, light: "#dd2c00", dark: "#ff4b1f" },
  { name: "Astro", Icon: SiAstro, light: "#bc52ee", dark: "#d58bf5" },
  { name: "Next.js", Icon: SiNextdotjs, light: "#000000", dark: "#ffffff" },
  { name: "Tailwind CSS", Icon: SiTailwindcss, light: "#06b6d4", dark: "#38bdf8" },
  { name: "Node.js", Icon: SiNodedotjs, light: "#5fa04e", dark: "#84bc76" },
  { name: "Python", Icon: SiPython, light: "#3776ab", dark: "#ffd43b" },
  { name: "FastAPI", Icon: SiFastapi, light: "#009688", dark: "#26b5a6" },
  { name: "TensorFlow Lite", Icon: SiTensorflow, light: "#ff6f00", dark: "#ff8f33" },
  { name: "Unity", Icon: SiUnity, light: "#000000", dark: "#ffffff" },
  { name: "Docker", Icon: SiDocker, light: "#2496ed", dark: "#4db3f5" },
];
---

<section
  aria-labelledby="tech-heading"
  class="border-y border-gray-200/70 py-8 dark:border-dark-800"
>
  <div class="section-container section-padding">
    <h2 id="tech-heading" class="text-muted text-center text-sm font-medium">
      Projelerde kullandığım teknolojiler
    </h2>
  </div>
  <div class="marquee mt-6 overflow-hidden">
    <div class="marquee-track flex w-max animate-marquee">
      {[false, true].map((copy) => (
        <ul class="flex flex-none gap-3 pr-3" aria-hidden={copy ? "true" : undefined}>
          {TECH.map(({ name, Icon, light, dark }) => (
            <li
              class="tech-chip flex flex-none items-center gap-2.5 rounded-full border px-4 py-2 text-sm font-medium text-gray-800 shadow-xs dark:text-gray-100"
              style={`--tech: ${light}; --tech-dark: ${dark}`}
            >
              <Icon
                size={17}
                aria-hidden="true"
                className="text-(--tech) dark:text-(--tech-dark)"
              />
              {name}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
